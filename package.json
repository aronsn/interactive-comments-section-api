{
  "name": "interactive-comments-section-api",
  "version": "1.0.0",
  "description": "rest-api",
  "main": "build/app.js",
  "type": "module",
  "scripts": {
    "dev": "npm run db:start && npx nodemon --watch . --ext ts --exec \"tsx --env-file=config.env server.ts\"",
    "build": "tsc && esbuild build/server.js --bundle --minify --format=esm --platform=node --outfile=build/app.js",
    "start": "node build/app.js",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:start": "sudo systemctl start mongod",
    "db:stop": "sudo systemctl stop mongod",
    "db:status": "sudo systemctl status mongod"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aronsn/interactive-comments-section-api.git"
  },
  "author": "Aron Snekkestad",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/aronsn/interactive-comments-section-api/issues"
  },
  "homepage": "https://github.com/aronsn/interactive-comments-section-api#readme",
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "^4.22.2",
    "mongodb": "6.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^26.0.1",
    "esbuild": "^0.28.1",
    "nodemon": "3.1.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
